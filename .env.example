# URL base do SysReptor (sem /api/v1)
SYSREPTOR_URL=http://sysreptor-app:8000

# Token real do SysReptor (fica SOMENTE aqui; nunca é entregue aos consumidores)
SYSREPTOR_API_TOKEN=sysreptor_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chaves de consulta entregues às equipes. Formato nome:chave, separadas por vírgula.
# Gere cada uma com:  openssl rand -hex 32
READONLY_API_KEYS=gestao-vulns:TROQUE_POR_UMA_CHAVE_DE_64_CARACTERES_HEX

# Opcional: limitar a projetos específicos (UUIDs separados por vírgula). Vazio = todos.
ALLOWED_PROJECT_IDS=

# Opcional: "false" apenas se o SysReptor usa certificado autoassinado
SYSREPTOR_VERIFY_TLS=true
